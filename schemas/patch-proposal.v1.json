{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NOURHANE-EHOUARI/sentinelci/schemas/patch-proposal.v1.json",
  "title": "SentinelCI Patch Proposal v1",
  "description": "A candidate fix for one or more findings. Produced by deterministic fixers (A6) or the LLM patch generator (B6), consumed by the remediation loop (A6). See docs/spec/SPEC.md section 9.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "proposal_id", "finding_ids", "strategy", "diff", "files", "rationale", "attempt", "created_at"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "proposal_id": { "type": "string", "format": "uuid" },
    "finding_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(?![^\\r\\n\\u2028\\u2029]*[\\r\\n\\u2028\\u2029])[a-f0-9]{64}$" }
    },
    "strategy": {
      "enum": [
        "deterministic:dependency-bump",
        "deterministic:dockerfile",
        "deterministic:kubernetes",
        "llm:code"
      ]
    },
    "diff": { "description": "Unified diff, must pass `git apply --check`.", "type": "string", "minLength": 1 },
    "files": {
      "description": "Every file the diff touches. Must be a subset of the files flagged by the findings.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "pattern": "^(?![^\\r\\n\\u2028\\u2029]*[\\r\\n\\u2028\\u2029])(?!/)(?!.*(^|/)\\.\\.(/|$)).+$" }
    },
    "rationale": { "type": "string", "minLength": 1 },
    "attempt": { "type": "integer", "minimum": 1, "maximum": 3 },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "prompt_version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string" },
        "prompt_version": { "type": "string", "minLength": 1 }
      }
    },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "strategy": { "const": "llm:code" } } },
      "then": { "required": ["model"] }
    }
  ]
}
