{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NOURHANE-EHOUARI/sentinelci/schemas/root-cause-group.v1.json",
  "title": "SentinelCI RootCauseGroup v1",
  "description": "Advisory output of the correlator (task A7, SPEC section 8): the findings of one run that share a root cause, and the one fix for them. Never read by the release gate: the verdict never depends on it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "group_id",
    "finding_ids",
    "stage",
    "title",
    "root_cause",
    "single_fix"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "group_id": {
      "description": "sha256 hex of the sorted finding ids joined by '|': the same members always give the same id.",
      "$ref": "#/$defs/sha256_hex"
    },
    "finding_ids": {
      "description": "Finding v1 ids (fingerprints), sorted, at least one. A finding is in exactly one group of a run.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sha256_hex"
      }
    },
    "stage": {
      "description": "The correlation stage that formed the group (SPEC section 8): dedup (one fingerprint), structural (a shared fix key such as a package), embedding (similar text), llm (labelled by a model). Each stage is measured separately.",
      "enum": [
        "dedup",
        "structural",
        "embedding",
        "llm"
      ]
    },
    "key": {
      "description": "The structural key the members share (for example package:pkg:npm/lodash), when there is one.",
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?![^\\r\\n\\u2028\\u2029]*[\\r\\n\\u2028\\u2029])\\S+$"
    },
    "title": {
      "description": "One line.",
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?![^\\r\\n\\u2028\\u2029]*[\\r\\n\\u2028\\u2029]).*\\S"
    },
    "root_cause": {
      "description": "One paragraph, no line break (a model's text is joined into one by the producer).",
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "^(?![^\\r\\n\\u2028\\u2029]*[\\r\\n\\u2028\\u2029]).*\\S"
    },
    "single_fix": {
      "description": "The one change that resolves every member, or null when there is none.",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "^(?![^\\r\\n\\u2028\\u2029]*[\\r\\n\\u2028\\u2029]).*\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "model": {
      "description": "For stage llm: what produced the labels (SPEC section 8: model, prompt and input hashes are logged).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "name",
        "prompt_sha256",
        "input_sha256"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^(?![^\\r\\n\\u2028\\u2029]*[\\r\\n\\u2028\\u2029])[a-z0-9._-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?![^\\r\\n\\u2028\\u2029]*[\\r\\n\\u2028\\u2029])[A-Za-z0-9._:/@-]+$"
        },
        "prompt_sha256": {
          "$ref": "#/$defs/sha256_hex"
        },
        "input_sha256": {
          "$ref": "#/$defs/sha256_hex"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "stage": {
            "const": "llm"
          }
        }
      },
      "then": {
        "required": [
          "model"
        ]
      },
      "else": {
        "not": {
          "required": [
            "model"
          ]
        }
      }
    }
  ],
  "$defs": {
    "sha256_hex": {
      "type": "string",
      "pattern": "^(?![^\\r\\n\\u2028\\u2029]*[\\r\\n\\u2028\\u2029])[a-f0-9]{64}$"
    }
  }
}
