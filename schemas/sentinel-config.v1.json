{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NOURHANE-EHOUARI/sentinelci/schemas/sentinel-config.v1.json",
  "title": "SentinelCI service context v1",
  "description": "The `sentinel.yaml` file at the root of a scan target (YAML holding this JSON shape; SPEC section 6.1 and 13.2). Gives enrichment (B2) the exposure of what is scanned and the gate (B4) its policy profile. A PR must not be able to lower its own exposure: the pipeline reads this file from the base branch, like the policies and the waivers.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "service",
    "exposure"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "service": {
      "$ref": "#/$defs/name"
    },
    "exposure": {
      "$ref": "#/$defs/exposure"
    },
    "environment": {
      "enum": [
        "production",
        "staging",
        "development",
        "test"
      ]
    },
    "data_classification": {
      "$ref": "#/$defs/data_classification"
    },
    "owners": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?![^\\r\\n\\u2028\\u2029]*[\\r\\n\\u2028\\u2029])@[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})(?:/[A-Za-z0-9._-]{1,100})?$"
      }
    },
    "policy_profile": {
      "enum": [
        "default",
        "strict"
      ]
    },
    "components": {
      "description": "Parts of the target with another exposure or data class (e.g. an internal API next to a public web app). A finding takes the component with the longest path containing its location; otherwise the top-level values.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path"
        ],
        "minProperties": 2,
        "properties": {
          "path": {
            "$ref": "#/$defs/relative_path"
          },
          "exposure": {
            "$ref": "#/$defs/exposure"
          },
          "data_classification": {
            "$ref": "#/$defs/data_classification"
          }
        }
      }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^(?![^\\r\\n\\u2028\\u2029]*[\\r\\n\\u2028\\u2029])[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "exposure": {
      "enum": [
        "internet-facing",
        "internal",
        "offline"
      ]
    },
    "data_classification": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![^\\r\\n\\u2028\\u2029]*[\\r\\n\\u2028\\u2029])(?!/)(?!.*(^|/)\\.\\.(/|$))[^\\\\]+$"
    }
  }
}
