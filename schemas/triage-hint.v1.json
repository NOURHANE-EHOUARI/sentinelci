{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NOURHANE-EHOUARI/sentinelci/schemas/triage-hint.v1.json",
  "title": "SentinelCI TriageHint v1",
  "description": "Advisory output of the AI analyst (task B5, SPEC section 8): whether one finding looks like a false positive, and why. Never read by the release gate, and never a waiver: only a reviewed waiver (waivers.v1.json) changes what the gate counts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "finding_id",
    "likely_false_positive",
    "rationale",
    "confidence",
    "model",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "finding_id": {
      "description": "The Finding v1 id (fingerprint) triaged.",
      "$ref": "#/$defs/sha256_hex"
    },
    "likely_false_positive": {
      "type": "boolean"
    },
    "rationale": {
      "description": "One paragraph, no line break: why, from the finding and its code.",
      "allOf": [
        {
          "$ref": "#/$defs/one_line"
        }
      ],
      "maxLength": 1000
    },
    "confidence": {
      "$ref": "#/$defs/confidence"
    },
    "model": {
      "$ref": "#/$defs/model"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "sha256_hex": {
      "type": "string",
      "pattern": "^(?![^\\r\\n\\u2028\\u2029]*[\\r\\n\\u2028\\u2029])[a-f0-9]{64}$"
    },
    "one_line": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![^\\r\\n\\u2028\\u2029]*[\\r\\n\\u2028\\u2029]).*\\S"
    },
    "model": {
      "description": "What produced the output (SPEC section 8: provider, model, and the hashes of the prompt and of the input are recorded).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "name",
        "prompt_sha256",
        "input_sha256"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^(?![^\\r\\n\\u2028\\u2029]*[\\r\\n\\u2028\\u2029])[a-z0-9._-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?![^\\r\\n\\u2028\\u2029]*[\\r\\n\\u2028\\u2029])[A-Za-z0-9._:/@-]+$"
        },
        "digest": {
          "description": "The model's digest, when the provider pins one (Ollama, ADR-0009).",
          "type": "string",
          "pattern": "^(?![^\\r\\n\\u2028\\u2029]*[\\r\\n\\u2028\\u2029])sha256:[a-f0-9]{64}$"
        },
        "prompt_sha256": {
          "$ref": "#/$defs/sha256_hex"
        },
        "input_sha256": {
          "$ref": "#/$defs/sha256_hex"
        }
      }
    },
    "confidence": {
      "description": "The model's own confidence, 0 to 1: a hint for the reader, not a measured probability.",
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
