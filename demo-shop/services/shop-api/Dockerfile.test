# The image shop-api's tests run in (B9, ADR-0014 decision 3; task A6's `llm:code` check). NOT a seed, never
# deployed, and it holds no application code: the check mounts the service read-only at /srv and runs
# `python -m pytest tests` with no network, a read-only root file system, no capability and as `nobody`.
#
# - The base is the release image's, pinned by the same digest (Dockerfile.release).
# - Dependencies are the release's (requirements.release.txt) plus pytest and httpx2 (requirements.test.txt),
#   both installed with `--require-hashes --no-deps` from wheels only: nothing unlisted, nothing built.
# - So the tests exercise the code with the libraries it ships with.
# - The build context is the allow-list in Dockerfile.test.dockerignore: the two requirements files only.
#
# Build it, and give the check its id (`sha256:...`), which pins it:
#   docker build -f demo-shop/services/shop-api/Dockerfile.test -q demo-shop/services/shop-api
ARG PYTHON=python:3.12.16-slim-trixie@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b

FROM ${PYTHON}
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_NO_CACHE_DIR=1 PYTHONDONTWRITEBYTECODE=1
COPY requirements.release.txt requirements.test.txt /tmp/
RUN python -m venv /opt/venv \
    && /opt/venv/bin/pip install --require-hashes --no-deps --only-binary :all: \
       --requirement /tmp/requirements.release.txt --requirement /tmp/requirements.test.txt \
    && rm /tmp/requirements.release.txt /tmp/requirements.test.txt
ENV PATH=/opt/venv/bin:/usr/local/bin:/usr/bin:/bin PYTHONUNBUFFERED=1
WORKDIR /srv
USER 65534:65534
CMD ["python", "-m", "pytest", "-q", "tests"]
