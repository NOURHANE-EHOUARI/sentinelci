{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Values of the demo-shop chart",
  "description": "Helm validates the merged values against this schema before it renders anything.",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "replicas", "port"],
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "digest"],
      "properties": {
        "repository": {
          "description": "A registry host and repository path, without a tag or digest.",
          "type": "string",
          "pattern": "^[a-z0-9.-]+(:[0-9]+)?(/[a-z0-9._-]+)+$"
        },
        "digest": {
          "description": "The release's manifest digest: the image is referenced by it only.",
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "replicas": {"type": "integer", "minimum": 1, "maximum": 3},
    "port": {"type": "integer", "minimum": 1024, "maximum": 65535}
  }
}
