{
  "name": "sentinelci-dashboard",
  "private": true,
  "version": "0.1.0",
  "description": "SentinelCI dashboard (task B7, SPEC section 10): React, TypeScript, Vite, TanStack Query, Tailwind, Recharts.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "client": "openapi-typescript ../../schemas/openapi.yaml --output src/api/schema.ts",
    "client:check": "openapi-typescript ../../schemas/openapi.yaml --output src/api/schema.ts --check",
    "check": "npm run client:check && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@tanstack/react-query": "5.107.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "29.1.1",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
